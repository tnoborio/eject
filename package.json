{
  "name": "eject",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "control-plane",
    "protocol"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "fast-uri": "3.1.4",
    "postcss": "8.5.20",
    "qs": "6.15.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.1.5"
  },
  "scripts": {
    "build": "npm run build --workspace @eject/control-plane",
    "check": "npm run check --workspace @eject/control-plane",
    "test": "npm run test --workspace @eject/protocol-contract && npm run test --workspace @eject/control-plane",
    "test:coverage": "npm run test:coverage --workspace @eject/control-plane"
  }
}
