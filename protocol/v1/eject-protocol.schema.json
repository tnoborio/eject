{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EJECT protocol v1 message",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "kind",
        "command_id",
        "type",
        "device_id",
        "actor",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "COMMAND" },
        "command_id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "OPTICAL_DRIVE_EJECT" },
        "device_id": { "$ref": "#/$defs/identifier" },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["person_id", "display_name"],
          "properties": {
            "person_id": { "$ref": "#/$defs/identifier" },
            "display_name": { "$ref": "#/$defs/displayName" }
          }
        },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "agentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "kind",
        "command_id",
        "device_id",
        "recorded_at",
        "disposition",
        "attempt_count",
        "result",
        "physical_outcome"
      ],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "AGENT_RESULT" },
        "command_id": { "$ref": "#/$defs/identifier" },
        "device_id": { "$ref": "#/$defs/identifier" },
        "recorded_at": { "$ref": "#/$defs/timestamp" },
        "disposition": { "enum": ["REJECTED", "ATTEMPTED"] },
        "attempt_count": { "type": "integer", "minimum": 0, "maximum": 1 },
        "result": { "type": "string" },
        "physical_outcome": { "enum": ["NOT_ATTEMPTED", "UNKNOWN"] }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "disposition": { "const": "REJECTED" },
                "attempt_count": { "const": 0 },
                "result": {
                  "enum": [
                    "INVALID_COMMAND",
                    "AUDIENCE_MISMATCH",
                    "COMMAND_EXPIRED",
                    "COMMAND_ISSUED_IN_FUTURE",
                    "COMMAND_REPLAYED",
                    "AGENT_PAUSED",
                    "NO_APPROVED_DRIVE",
                    "COMMAND_UNSUPPORTED"
                  ]
                },
                "physical_outcome": { "const": "NOT_ATTEMPTED" }
              }
            },
            {
              "properties": {
                "disposition": { "const": "ATTEMPTED" },
                "attempt_count": { "const": 1 },
                "result": {
                  "enum": [
                    "COMMAND_ACCEPTED",
                    "DRIVE_NOT_FOUND",
                    "DRIVE_BUSY",
                    "DRIVE_NOT_READY",
                    "DRIVE_UNSUPPORTED",
                    "DRIVE_DISCONNECTED",
                    "ACCESS_DENIED",
                    "FAILED"
                  ]
                },
                "physical_outcome": { "const": "UNKNOWN" }
              }
            }
          ]
        }
      ]
    },
    "lifecycleEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "kind",
        "event_id",
        "command_id",
        "state",
        "reason_code",
        "occurred_at"
      ],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "LIFECYCLE_EVENT" },
        "event_id": { "$ref": "#/$defs/identifier" },
        "command_id": { "$ref": "#/$defs/identifier" },
        "state": {
          "enum": [
            "REQUESTED",
            "REJECTED",
            "AUTHORIZED",
            "QUEUED",
            "DISPATCHED",
            "DELIVERED",
            "REJECTED_BY_AGENT",
            "ATTEMPTED",
            "EXPIRED",
            "CANCELLED",
            "FAILED",
            "OUTCOME_UNKNOWN"
          ]
        },
        "reason_code": { "type": ["string", "null"] },
        "occurred_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "state": {
                  "enum": [
                    "REQUESTED",
                    "AUTHORIZED",
                    "QUEUED",
                    "DISPATCHED",
                    "DELIVERED",
                    "ATTEMPTED"
                  ]
                },
                "reason_code": { "const": null }
              }
            },
            {
              "properties": {
                "state": { "const": "REJECTED" },
                "reason_code": {
                  "enum": [
                    "PERMISSION_REQUIRED",
                    "RECIPIENT_PAUSED",
                    "QUIET_HOURS_ACTIVE",
                    "COOLDOWN_ACTIVE",
                    "RATE_LIMITED",
                    "DEVICE_UNAVAILABLE",
                    "ACTOR_RESTRICTED"
                  ]
                }
              }
            },
            {
              "properties": {
                "state": { "const": "REJECTED_BY_AGENT" },
                "reason_code": {
                  "enum": [
                    "INVALID_COMMAND",
                    "AUDIENCE_MISMATCH",
                    "COMMAND_EXPIRED",
                    "COMMAND_ISSUED_IN_FUTURE",
                    "COMMAND_REPLAYED",
                    "AGENT_PAUSED",
                    "NO_APPROVED_DRIVE",
                    "COMMAND_UNSUPPORTED"
                  ]
                }
              }
            },
            {
              "properties": {
                "state": { "const": "EXPIRED" },
                "reason_code": { "const": "COMMAND_EXPIRED" }
              }
            },
            {
              "properties": {
                "state": { "const": "CANCELLED" },
                "reason_code": {
                  "enum": [
                    "PERMISSION_REVOKED",
                    "DEVICE_REVOKED",
                    "DELIVERY_DISABLED"
                  ]
                }
              }
            },
            {
              "properties": {
                "state": { "const": "FAILED" },
                "reason_code": {
                  "enum": [
                    "DRIVE_NOT_FOUND",
                    "DRIVE_BUSY",
                    "DRIVE_NOT_READY",
                    "DRIVE_UNSUPPORTED",
                    "DRIVE_DISCONNECTED",
                    "ACCESS_DENIED",
                    "FAILED"
                  ]
                }
              }
            },
            {
              "properties": {
                "state": { "const": "OUTCOME_UNKNOWN" },
                "reason_code": { "const": "PHYSICAL_OUTCOME_UNVERIFIED" }
              }
            }
          ]
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/command" },
    { "$ref": "#/$defs/agentResult" },
    { "$ref": "#/$defs/lifecycleEvent" }
  ]
}
